  "properties": {
    "sample_id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique id; tint/mixture rows end in -W or -B; substrates are SUB-W / SUB-B"
    },
    "type": {
      "type": "string",
      "enum": [
        "substrate_white",
        "substrate_black",
        "masstone_over_white",
        "masstone_over_black",
        "tint",
        "mixture"
      ]
    },
    "substrate": {
      "type": "string",
      "enum": [
        "white",
        "black"
      ]
    },
    "components": {
      "type": "string",
      "pattern": "^\\s*$|^\\s*[a-z0-9][a-z0-9_.-]*\\s*:\\s*[0-9.eE+-]+\\s*(;\\s*[a-z0-9][a-z0-9_.-]*\\s*:\\s*[0-9.eE+-]+\\s*)*;?\\s*$",
      "description": "paint_id:volume_fraction;... summing to 1 (tolerance 0.002); empty for substrates"
    },
    "components_mass_g": {
      "type": "string",
      "pattern": "^\\s*$|^\\s*[a-z0-9][a-z0-9_.-]*\\s*:\\s*[0-9.eE+-]+\\s*(;\\s*[a-z0-9][a-z0-9_.-]*\\s*:\\s*[0-9.eE+-]+\\s*)*;?\\s*$",
      "description": "Optional weighed masses paint_id:grams;... (overrides components)"
    },
    "notes": {
      "type": "string",
      "description": "Semicolon-separated tokens: gap_um=<number>, holdout, free text"
    },
    "measured_at": {
      "type": "string"
    },
    "n_readings": {
      "type": "string",
      "pattern": "^\\s*\\d*\\s*$"
    },
    "r400": {
      "type": "string",
      "pattern": "^\\s*(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][-+]?\\d+)?\\s*$",
      "description": "reflectance 0-1.2"
    },
    "r410": {
      "type": "string",
