{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paintmixer.local/schemas/calibration_row.schema.json",
  "title": "PaintMixer calibration CSV row",
  "type": "object",
  "required": [
    "sample_id",
    "type",
    "substrate",
    "components",
    "notes",
    "r400",
    "r410",
    "r420",
    "r430",
    "r440",
    "r450",
    "r460",
    "r470",
    "r480",
    "r490",
    "r500",
    "r510",
    "r520",
